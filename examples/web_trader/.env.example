WEB_PUBLISH_PORT=8000
WEB_USERNAME=vnpy
WEB_PASSWORD=vnpy
WEB_SECRET_KEY=change-me-to-a-long-random-string

DATABASE_USER=admin
DATABASE_PASSWORD=quest
DATABASE_NAME=qdb

# 国内机器拉不到 Docker Hub 时改用镜像，例如：
# QUESTDB_IMAGE=docker.m.daocloud.io/questdb/questdb:8.2.3
QUESTDB_IMAGE=questdb/questdb:8.2.3
DEBIAN_MIRROR=

# 实盘铁鹰（生产设 LIVE_IRON_CONDOR=1 且 LIVE_DRY_RUN=0）
LIVE_IRON_CONDOR=0
LIVE_DRY_RUN=1
LIVE_PORTFOLIOS=IO.CFFEX
LIVE_GATEWAY=CTP
LIVE_SCRIPT=gex_tv_strangle.py
# IO.CFFEX 推荐（日线回测+样本外）：宽翼 + 更高权利金门槛；风险预算默认 6%
LIVE_WING_STEPS=5
LIVE_MIN_CREDIT_FRAC=0.30
LIVE_RISK_CAP=0.06
LIVE_MAX_LOTS=80
# LIVE_MIN_DELTA=0.14
# LIVE_MAX_DELTA=0.25
# LIVE_IV_RANK_MIN=40
# LIVE_TAKE_PROFIT=0.25
