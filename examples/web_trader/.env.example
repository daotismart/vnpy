WEB_PUBLISH_PORT=8000
WEB_USERNAME=vnpy
WEB_PASSWORD=vnpy
WEB_SECRET_KEY=change-me-to-a-long-random-string

DATABASE_USER=admin
DATABASE_PASSWORD=quest
DATABASE_NAME=qdb

# 国内机器拉不到 Docker Hub 时改用镜像，例如：
# QUESTDB_IMAGE=docker.m.daocloud.io/questdb/questdb:8.2.3
# REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4-alpine
QUESTDB_IMAGE=questdb/questdb:8.2.3
REDIS_IMAGE=redis:7.4-alpine
DEBIAN_MIRROR=
REDIS_URL=redis://redis:6379/0

# 架构：recorder 独占 CTP 行情 → Redis → QuestDB；web 从 Redis 取行情，CTP 只登录交易前置
LIVE_MD_SOURCE=redis
LIVE_RECORDER_RELEASE_TD=1
LIVE_AUTO_CONNECT_CTP=1
WEB_LIVE_RECORD_TICKS=0

# 实盘铁鹰（生产设 LIVE_IRON_CONDOR=1 且 LIVE_DRY_RUN=0）
LIVE_IRON_CONDOR=1
LIVE_DRY_RUN=0
LIVE_PORTFOLIOS=IO.CFFEX
LIVE_GATEWAY=CTP
LIVE_SCRIPT=gex_tv_strangle.py
LIVE_RECORD_TICKS=1
# 0=全部到期月（约 230+ 合约，CTP 行情易积压冻结）；稳定优先可先用 2
LIVE_RECORD_MAX_CHAINS=2
LIVE_RECORD_BAR=1
LIVE_RECORD_FILTER_WINDOW=3600
LIVE_MD_MAX_LAG_SEC=90

# IO.CFFEX 推荐（日线回测+样本外）：宽翼 + 更高权利金门槛；风险预算默认 6%
LIVE_WING_STEPS=5
LIVE_MIN_CREDIT_FRAC=0.30
LIVE_RISK_CAP=0.06
LIVE_MAX_LOTS=80
# LIVE_MIN_DELTA=0.14
# LIVE_MAX_DELTA=0.25
# LIVE_IV_RANK_MIN=40
# LIVE_TAKE_PROFIT=0.25

# 备兑看涨错价收割（脚本页启动 io_covered_call.py；默认模拟 + 日内平仓）
# CC_EDGE_TICKS=2.5
# CC_CALL_LOTS=3
# CC_TAKE_PROFIT=0.45
# CC_DELTA_STOP=0.55
# CC_FLAT_EOD=1
# CC_MIN_DELTA=0.12
# CC_MAX_DELTA=0.40
